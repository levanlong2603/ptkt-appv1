# ====== Cấu hình máy chủ – sao chép thành file .env rồi sửa ======
# Cổng nội bộ ứng dụng lắng nghe (Nginx sẽ chuyển tiếp vào đây)
PORT=3000
# 127.0.0.1 = chỉ nhận kết nối từ chính máy chủ (qua Nginx). Giữ nguyên.
HOST=127.0.0.1
# Chuỗi bí mật ký phiên đăng nhập – BẮT BUỘC thay bằng chuỗi ngẫu nhiên (lệnh: openssl rand -hex 32)
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_IT_NHAT_32_KY_TU
# true nếu truy cập bằng https://, false nếu chỉ dùng http:// trong mạng nội bộ
COOKIE_SECURE=false
# Số ngày giữ đăng nhập
SESSION_DAYS=30

# ====== Cơ sở dữ liệu ======
# mariadb (máy chủ thật)  |  sqlite (máy lập trình cá nhân / phương án dự phòng)
DB_CLIENT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ptkt
DB_USER=ptkt
# Mật khẩu tài khoản MariaDB – dùng chuỗi chỉ gồm chữ và số (lệnh: openssl rand -hex 24)
DB_PASSWORD=THAY_BANG_MAT_KHAU_MARIADB

# Chỉ dùng khi DB_CLIENT=sqlite (và cho công cụ chuyển dữ liệu): thư mục chứa file ptkt.db
DATA_DIR=/var/lib/ptkt

# ====== Bot Telegram (tuỳ chọn – xem backend/bot/index.js) ======
# Token lấy từ @BotFather trên Telegram – giữ bí mật như mật khẩu. Đặt ở CẢ HAI máy của cụm
# (để máy nào phục vụ trang web cũng cấp được mã liên kết).
TELEGRAM_BOT_TOKEN=
# true = máy này nhận tin nhắn và chạy lịch tự động. Trong cụm 2 máy chỉ đặt true ở MỘT máy
# (2 máy cùng chạy 1 bot → Telegram báo lỗi 409). Máy kia để false.
TELEGRAM_ENABLED=false
# Máy chủ chỉ cần ra được Internet tới api.telegram.org:443 (không cần mở cổng vào). Nếu phải qua proxy (Node ≥ 24):
# HTTPS_PROXY=http://proxy.congty.vn:3128
# NODE_USE_ENV_PROXY=1

# ====== AI hiểu câu tự do cho bot (tuỳ chọn) – không bật thì bot chỉ dùng nút bấm ======
# none | anthropic | openai   (đổi hãng chỉ cần đổi 3 dòng này)
AI_PROVIDER=none
AI_API_KEY=
# Để trống = mặc định của hãng (anthropic: claude-opus-5-5; openai: gpt-4o-mini).
# Việc trích xuất này đơn giản – muốn tiết kiệm chi phí với Claude có thể đặt claude-haiku-5-5.
AI_MODEL=
